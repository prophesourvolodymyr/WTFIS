                </figure>
                <figure class="cta-card scroll-stack-card">
                  <div class="cta-shot has-image">
                    <img class="cta-shot-image" src={`${base}Deep%20Settings.png`} alt="WTFIS settings for configuring directory discovery" decoding="async" width="1541" height="1201" />
