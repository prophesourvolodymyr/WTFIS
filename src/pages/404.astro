<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f42f3" />
    <meta name="robots" content="noindex" />
    <title>WTFIS / 404</title>
    <link rel="icon" type="image/png" href="/Tab%20logo.png?v=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@800;900&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --blue: #1f42f3;
        --blue-deep: #0b28b6;
        --paper: #fbfbf7;
        --acid: #d4ff45;
        --edge: clamp(1rem, 3vw, 3.5rem);
      }

      * { box-sizing: border-box; }

      html, body { min-width: 320px; min-height: 100%; }

      body {
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        background: var(--blue);
        color: var(--paper);
        font-family: "IBM Plex Mono", monospace;
      }

      .not-found {
        position: relative;
        display: grid;
        min-height: 100svh;
        grid-template-rows: auto 1fr auto;
        isolation: isolate;
        padding: var(--edge);
      }

      .not-found::before,
      .not-found::after {
        position: absolute;
        z-index: -1;
        content: "";
        pointer-events: none;
      }

      .not-found::before {
        inset: 0;
        background-image:
          linear-gradient(to right, rgba(251, 251, 247, 0.15) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(251, 251, 247, 0.15) 1px, transparent 1px);
        background-size: clamp(3.5rem, 8vw, 7rem) clamp(3.5rem, 8vw, 7rem);
        mask-image: radial-gradient(circle at 50% 52%, black 0 24%, rgba(0, 0, 0, 0.35) 62%, transparent 100%);
      }

      .not-found::after {
        top: -30vmax;
        right: -28vmax;
        width: 70vmax;
        aspect-ratio: 1;
        border: 1px solid rgba(212, 255, 69, 0.44);
        border-radius: 50%;
        box-shadow: 0 0 0 12vmax rgba(212, 255, 69, 0.04), 0 0 0 24vmax rgba(212, 255, 69, 0.025);
      }

      .not-found-nav,
      .not-found-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        font-size: clamp(0.62rem, 1vw, 0.74rem);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: inherit;
        text-decoration: none;
      }

      .brand img { width: 2.1rem; height: 2.1rem; object-fit: contain; }

      .not-found-meta { color: rgba(251, 251, 247, 0.6); }

      .not-found-content {
        display: grid;
        align-content: center;
        justify-items: center;
        padding-block: clamp(2rem, 8vh, 7rem);
        text-align: center;
      }

      .code {
        position: relative;
        margin: 0;
        color: var(--paper);
        font-family: "Inter", sans-serif;
        font-size: clamp(9rem, 31vw, 31rem);
        font-weight: 900;
        letter-spacing: -0.13em;
        line-height: 0.67;
        text-indent: -0.13em;
        text-shadow: clamp(0.25rem, 1vw, 1rem) clamp(0.25rem, 1vw, 1rem) 0 var(--blue-deep);
        animation: code-arrive 600ms cubic-bezier(.16, 1, .3, 1) both;
      }

      .code::after {
        position: absolute;
        right: 2%;
        top: -0.35em;
        content: ">_";
        color: var(--acid);
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.12em;
        letter-spacing: -0.08em;
        text-shadow: none;
        animation: cursor-blink 900ms steps(1) infinite;
      }

      .message {
        max-width: 32rem;
        margin: clamp(2rem, 7vw, 4.5rem) 0 0;
        font-size: clamp(1rem, 2.1vw, 1.7rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.25;
        animation: message-arrive 450ms 180ms both;
      }

      .home-link {
        display: inline-flex;
        align-items: center;
        min-height: 3.25rem;
        margin-top: clamp(1.2rem, 3vw, 2rem);
        border: 1px solid var(--acid);
        padding: 0.8rem 1rem;
        background: var(--acid);
        color: var(--blue-deep);
        font-size: 0.73rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
        transition: background 160ms ease, color 160ms ease, transform 160ms ease;
        animation: message-arrive 450ms 280ms both;
      }

      .home-link:hover,
      .home-link:focus-visible {
        background: var(--paper);
        border-color: var(--paper);
        color: var(--blue-deep);
        outline: none;
        transform: translateY(-0.2rem);
      }

      @keyframes code-arrive {
        from { opacity: 0; transform: translateY(0.13em) scale(0.85) rotate(-3deg); }
        to { opacity: 1; transform: translateY(0) scale(1) rotate(0); }
      }

      @keyframes message-arrive {
        from { opacity: 0; transform: translateY(1rem); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes cursor-blink { 50% { opacity: 0; } }

      @media (max-width: 520px) {
        .not-found-meta span:last-child { display: none; }
        .code { font-size: clamp(8rem, 38vw, 12rem); }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
      }
    </style>
  </head>
  <body>
    <main class="not-found">
      <header class="not-found-nav">
        <a class="brand" href="/" aria-label="WTFIS home">
          <img src="/WTFIS%20logo%20main.png" alt="" width="1024" height="1024" />
          <span>WTFIS</span>
        </a>
        <span>404 / Path not found</span>
      </header>
      <section class="not-found-content" aria-labelledby="not-found-title">
        <h1 class="code" id="not-found-title">404</h1>
        <p class="message">Nothing Fucking to see here.</p>
        <a class="home-link" href="/">&lt;- Back home</a>
      </section>
      <footer class="not-found-meta">
        <span>WTFIS CLI</span>
        <span>Find the folder, then move on.</span>
      </footer>
    </main>
  </body>
</html>
